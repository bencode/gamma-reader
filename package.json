{
  "name": "gamma-reader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gamma-reader/web --filter @gamma-reader/server dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r --if-present test:integration",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm test:integration",
    "build": "pnpm -r build",
    "start": "pnpm --filter @gamma-reader/server start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13"
  }
}
